<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="CENTER" prefHeight="351.0" prefWidth="333.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.demo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
   <Pane prefHeight="299.0" prefWidth="319.0">
      <children>
          <Button layoutX="14.0" layoutY="150.0" onAction="#onHelloButtonClick" text="Circulo" />
         <Button layoutX="102.0" layoutY="150.0" mnemonicParsing="false" text="Rectangulo" />
         <Button layoutX="204.0" layoutY="150.0" mnemonicParsing="false" text="Cuadrado" />
         <Button layoutX="104.0" layoutY="210.0" mnemonicParsing="false" text="Calcular Area" />
         <Circle fx:id="mostrarCirculo" fill="DODGERBLUE" layoutX="140.0" layoutY="72.0" radius="58.0" stroke="BLACK" strokeType="INSIDE" visible="false" />
      </children>
   </Pane>
</VBox>
